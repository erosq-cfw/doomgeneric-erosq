#!/bin/sh
# Launched from erosq-ui Extras -> Games (no args). Free RAM by stopping MPD,
# run Doom, then restore MPD. -mb caps Doom's zone heap for the ~7.5MB board.
#
# -nosound: HITL-verified 2026-07-06 that streaming SFX to the ES9018K2M via
# tinyalsa reliably resets the device after 15-100s (watchdog reset; -nosound
# runs stable indefinitely, confirmed 150s+). The sound backend itself is
# correct (SFX are audible), but sustained PCM streaming wedges the audio DMA
# on this board. Re-enable by dropping -nosound once the driver path is fixed
# (needs serial-console capture of the hang). See INTERFACES.md / memory.
was_up=; pgrep mpd >/dev/null && was_up=1
[ "$was_up" ] && { mpc stop 2>/dev/null; killall mpd 2>/dev/null; }
/usr/bin/doomgeneric -iwad /media/sd/games/DOOM1.WAD -mb 4 -nosound
[ "$was_up" ] && mpd 2>/dev/null
