#!/bin/sh
# Launched from erosq-ui Extras -> Games (no args). Free RAM + the ALSA PCM
# device by stopping MPD, run Doom, then restore MPD. -mb caps Doom's zone heap
# for the ~7.5MB board (tune down on HW if MemAvailable runs tight).
was_up=; pgrep mpd >/dev/null && was_up=1
if [ "$was_up" ]; then
    mpc stop 2>/dev/null; killall mpd 2>/dev/null
    # killall only signals; wait (bounded) for mpd to actually release the PCM
    # device so pcm_open in the sound backend doesn't lose the race.
    i=0; while pgrep mpd >/dev/null 2>&1 && [ $i -lt 5 ]; do sleep 1; i=$((i+1)); done
fi
/usr/bin/doomgeneric -iwad /media/sd/games/DOOM1.WAD -mb 4
[ "$was_up" ] && mpd 2>/dev/null
